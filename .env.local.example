# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and is never sent to the browser unless the
# variable name starts with NEXT_PUBLIC_.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
# These two are safe in the browser. The anon key is designed to be public;
# Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where magic-link emails should send people back to.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LLM (not used yet, added in Step 4) ------------------------------------
# NO NEXT_PUBLIC_ PREFIX. This must never reach the browser.
ANTHROPIC_API_KEY=

# --- Nearby places (Eat out -> "Find food near me") ---------------------------
# Google Maps Platform -> enable "Places API (New)" -> create an API key.
# NO NEXT_PUBLIC_ PREFIX — read only in src/lib/places/index.ts, server-side.
# Restrict the key to the Places API (New) in the Google Cloud console. Unset
# is fine: "Find food near me" then says nearby search isn't set up, and the
# category-based Eat out flow is unaffected.
GOOGLE_PLACES_API_KEY=

# --- Recipe images (Cook mode only) ------------------------------------------
# Get a free key at https://www.pexels.com/api/. NO NEXT_PUBLIC_ PREFIX — read
# only in src/app/api/image/route.ts. Unset is fine: recipe images just fall
# back to the no-image state everywhere.
PEXELS_API_KEY=
