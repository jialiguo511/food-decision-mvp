# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and is never sent to the browser unless the
# variable name starts with NEXT_PUBLIC_.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
# These two are safe in the browser. The anon key is designed to be public;
# Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for "Delete my account" (Me -> Account & data). Supabase dashboard
# -> Project Settings -> API -> service_role. NO NEXT_PUBLIC_ PREFIX, never in
# browser code: it bypasses Row Level Security. Without it, deleting an account
# is refused with a clear message; "Reset my data" never needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic-link emails should send people back to.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LLM (not used yet, added in Step 4) ------------------------------------
# NO NEXT_PUBLIC_ PREFIX. This must never reach the browser.
ANTHROPIC_API_KEY=

# --- Nearby places (Eat out -> "Find food near me") ---------------------------
# Google Maps Platform -> enable "Places API (New)" -> create an API key.
# NO NEXT_PUBLIC_ PREFIX — read only in src/lib/places/index.ts, server-side.
# Restrict the key to the Places API (New) in the Google Cloud console. Unset
# is fine: "Find food near me" then says nearby search isn't set up, and the
# category-based Eat out flow is unaffected.
GOOGLE_PLACES_API_KEY=

# --- Recipe images (Cook mode only) ------------------------------------------
# Get a free key at https://www.pexels.com/api/. NO NEXT_PUBLIC_ PREFIX — read
# only in src/app/api/image/route.ts. Unset is fine: recipe images just fall
# back to the no-image state everywhere.
PEXELS_API_KEY=

# --- Generated recipe images (Cook mode; optional fallback) -------------------
# Used ONLY when no relevant real photo exists for a recipe. Generated once per
# dish, then cached for everyone (Supabase Storage bucket `recipe-images` — run
# supabase/migrations/2026-10-02_recipe_images.sql). NO NEXT_PUBLIC_ PREFIX.
# Unset is fine: such recipes keep the quiet "no photo" band. Restaurants never
# use generated images.
OPENAI_API_KEY=
# Optional overrides (defaults: gpt-image-2, 1536x1024, low quality, WebP —
# about $0.005 an image at OpenAI's published price):
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1536x1024
# OPENAI_IMAGE_QUALITY=low

# --- Recommender speed / model (optional; unset = the defaults in claude.ts) --
# Cook / Get food (by type) / Snack use RECOMMEND_MODEL (default claude-sonnet-5-5)
# with adaptive thinking at RECOMMEND_EFFORT (low | medium | high; default low).
# The default was chosen from `npm run bench:recommend`: ~8 s a request against
# ~25 s for claude-opus-5 at high effort, with comparable results. Trying another
# setting is just editing these — the dev server logs a timing table per request
# ("[timing] Cook ..."). RECOMMEND_THINKING=off turns thinking off.
# RECOMMEND_MODEL=claude-opus-5
# RECOMMEND_EFFORT=high
# RECOMMEND_THINKING=adaptive
# The nearby "why this fits" wording uses a small fast model:
# ENRICH_MODEL=claude-haiku-4-5-20251001
